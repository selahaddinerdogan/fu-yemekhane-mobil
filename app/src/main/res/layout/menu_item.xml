<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tarih"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/date"
        android:textAlignment="center"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:padding="5sp"
        android:textStyle="bold" />


    <TextView
        android:id="@+id/anaYemekTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/teal_200"
        android:text="Ana Yemek"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/anaYemek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/teal_200"
        android:scrollHorizontally="false"
        android:textColor="@android:color/black"
        android:padding="5sp"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/yardimciYemekTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_200"
        android:text="Yardımcı Yemek"
        android:textSize="16sp"
        android:padding="5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/yardimciYemek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_200"
        android:scrollHorizontally="false"
        android:textColor="@android:color/black"
        android:padding="5sp"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/corbaTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green"
        android:text="Corba"
        android:textSize="16sp"
        android:padding="5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/corba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green"
        android:scrollHorizontally="false"
        android:textColor="@android:color/black"
        android:padding="5sp"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/salataTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/yellow"
        android:text="Salata"
        android:textSize="16sp"
        android:padding="5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/salata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/yellow"
        android:scrollHorizontally="false"
        android:textColor="@android:color/black"
        android:padding="5sp"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tatliTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/orange"
        android:text="Tatlı"
        android:textSize="16sp"
        android:padding="5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tatli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/orange"
        android:scrollHorizontally="false"
        android:textColor="@android:color/black"
        android:padding="5sp"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/icecekTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue"
        android:text="İçecek"
        android:textSize="16sp"
        android:padding="5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/icecek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue"
        android:scrollHorizontally="false"
        android:textColor="@android:color/black"
        android:padding="5sp"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/toplamKalori"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kalori"
        android:scrollHorizontally="false"
        android:textColor="@android:color/black"
        android:padding="5sp"
        android:textStyle="bold"
        android:textSize="14sp" />

</LinearLayout>
